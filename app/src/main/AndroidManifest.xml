<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Deliberately no INTERNET permission. The analysis is arithmetic over the
      local log and there is no food database to look anything up in, so the app
      has nothing to say to the network and cannot leak a health diary.
    -->

    <!-- The only network this app does: asking GitHub whether a newer build
         exists, and fetching it. Nothing is uploaded and nothing is tracked. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Needed to hand a downloaded APK to the system installer. It does not
         let the app install anything silently — Android still shows its own
         confirmation, and still refuses any APK not signed by the same key. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FoodDiary">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <!-- Where the install session reports back. Not exported: only the
             system's own PendingIntent targets it. -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />

    </application>

</manifest>
